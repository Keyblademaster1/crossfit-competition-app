// The shape of the database. Each `model` below becomes one table.
// After changing this file, run:  npx prisma migrate dev

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// How a competition decides who is on the leaderboard.
enum CompetitionMode {
  /// Everyone works alone and scores for themselves.
  INDIVIDUAL
  /// Individuals carry their own points. Teams are regrouped before each event.
  SCRAMBLE
  /// Teams carry the points and stay the same all day.
  FIXED_TEAM
}

/// How a place in an event turns into points.
enum PointsSystem {
  /// 1st gets 100 and every place below drops by the same amount.
  /// Highest total wins. A no-show scores 0.
  HUNDRED_STEPS
  /// 1st = 1 point, 2nd = 2. Lowest total wins. A no-show gets last place + 1.
  PLACING
}

/// What to do when two results in an event are exactly the same.
enum EventTieRule {
  /// Both take the higher place. The next one down skips a place.
  SHARE_HIGHER
  /// The faster tiebreak time takes the higher place; share it if neither has one.
  TIEBREAK_TIME
  /// Both get the average of the places they occupy.
  SHARE_AVERAGE
}

/// How teams are put together before an event.
enum DrawMethod {
  RANDOM
  /// Rank by standing, then pair the top with the bottom.
  SNAKE
  /// One from the top half of the standings with one from the bottom half.
  HALVES
  /// The organiser picks.
  MANUAL
}

/// Whether athletes may end up with the same teammate twice.
enum TeammateRule {
  ALWAYS_DIFFERENT
  AVOID_REPEATS
  ALLOW_REPEATS
}

/// Whether the draw pays attention to gender.
enum DrawGender {
  IGNORE
  /// Every team is one woman and one man where possible.
  MIXED
  /// Teams are same gender where possible.
  SAME
}

/// Where a fixed team's line-up comes from.
enum FixedTeamSource {
  /// Athletes sign up together.
  SIGNUP
  /// Drawn at random once, then fixed.
  DRAWN
  /// Best with worst by seed once, then fixed.
  BALANCED
}

enum Gender {
  WOMAN
  MAN
  OTHER
}

/// What the load is actually on. Only a barbell is made up from plates; a
/// sandbag weighs what it weighs.
///
/// Each of these is drawn as itself on the heats and workout screens, so that
/// a lane can be read at a glance. That is the reason for naming the ones that
/// carry no weight at all: a lane still has to have a rower in it.
enum Implement {
  BARBELL
  DUMBBELL
  KETTLEBELL
  SANDBAG
  WALL_BALL
  BOX
  /// A rower, a bike or a ski erg — whatever the calories are done on.
  ROWER
  JUMP_ROPE
  /// A bar or a rig: pull-ups, toes-to-bar, muscle-ups.
  PULL_UP_BAR
  /// Nothing to fetch, or nothing we have a name for.
  OTHER
}

/// Whether everyone lifts their own load, or the team shares one.
enum LoadMode {
  EACH
  SHARED
}

/// What happened to a result.
enum ScoreStatus {
  FINISHED
  /// Hit the time cap, or stopped early. Scored on reps completed.
  CAPPED
  /// Never started.
  NO_SHOW
}

/// How the next set of scramble teams is drawn.
enum ScrambleMethod {
  /// Pure chance.
  RANDOM
  /// Best with worst: rank everyone, then pair down the list from both ends.
  SNAKE
}

/// What kind of number an event is scored with.
enum ScoreType {
  /// Finish time, stored as whole seconds. Lower is better.
  TIME
  /// Finish time if they made the cap, otherwise reps completed.
  TIME_OR_REPS
  /// Total repetitions. Higher is better.
  REPS
  /// Rounds plus leftover reps, stored as total reps. Higher is better.
  ROUNDS_REPS
  /// Weight lifted, stored in grams. Higher is better.
  WEIGHT
}

model Competition {
  id        String          @id @default(cuid())
  name      String
  mode      CompetitionMode?
  /// How many athletes per team when scrambling. Unused for fixed teams.
  teamSize  Int?
  /// When and where, both optional while the competition is still a draft.
  date      DateTime?
  venue     String?
  createdAt DateTime        @default(now())

  // --- Scoring rules, chosen in the setup wizard ---
  pointsSystem PointsSystem @default(HUNDRED_STEPS)
  eventTieRule EventTieRule @default(SHARE_HIGHER)

  // --- Draw settings, used when teams are scrambled ---
  // Empty until the organiser picks one: the wizard offers them unchosen, so
  // nothing is decided for them without their noticing.
  drawMethod      DrawMethod?
  teammateRule    TeammateRule?
  drawGender      DrawGender?
  /// Spread the 60+ athletes across teams rather than letting them clump.
  spreadSixtyPlus Boolean          @default(false)
  /// Only meaningful for fixed teams. Empty until chosen, like the above.
  fixedTeamSource FixedTeamSource?

  /// How many lanes the floor has, which decides how big a heat can be.
  lanesPerHeat Int @default(3)

  // --- Sharing ---
  /// Let athletes look up their own results, via a QR code.
  athleteAccess Boolean @default(false)
  /// Publish a read-only leaderboard link.
  publicLink    Boolean @default(false)

  divisions Division[]
  athletes  Athlete[]
  teams     Team[]
  events    Event[]
}

/// A category athletes compete within, e.g. "RX Women". Leaderboards are
/// always ranked inside a division, never across them.
model Division {
  id            String @id @default(cuid())
  competitionId String
  name          String
  /// Display order on the leaderboard.
  position      Int    @default(0)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  athletes    Athlete[]
  teams       Team[]
  movements   Movement[]

  @@unique([competitionId, name])
}

model Athlete {
  id            String  @id @default(cuid())
  competitionId String
  divisionId    String?
  name          String
  gender        Gender?
  /// 60+ athletes get lighter loads and can be spread across teams. This is
  /// not a division: they are ranked with everyone else.
  isSixtyPlus   Boolean @default(false)

  competition Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  division    Division?    @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  scores      Score[]
  memberships TeamMember[]
  lanes       Lane[]

  @@unique([competitionId, name])
}

model Team {
  id            String  @id @default(cuid())
  competitionId String
  divisionId    String?
  /// Null for a fixed team that lasts the whole competition.
  /// Set for a scramble team that exists only for one event.
  eventId       String?
  name          String

  competition Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  division    Division?    @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  event       Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  scores      Score[]
  lanes       Lane[]
}

/// Joins athletes to teams. An athlete can be on several scramble teams over a
/// day, but only one per event.
model TeamMember {
  teamId    String
  athleteId String

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@id([teamId, athleteId])
}

/// One workout.
model Event {
  id             String    @id @default(cuid())
  competitionId  String
  name           String
  /// Running order of the events.
  position       Int       @default(0)
  scoreType      ScoreType
  /// Whether a bigger number wins. Times say false, everything else true.
  higherIsBetter Boolean
  /// Time cap in seconds, if the workout has one.
  timeCapSeconds Int?
  /// Reps in one full round, so a ROUNDS_REPS score can be shown as "5+12".
  repsPerRound   Int?

  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  scores        Score[]
  scrambleTeams Team[]
  movements     Movement[]
  heats         Heat[]
}

/// A group who go at the same time, because the floor only has so many lanes.
model Heat {
  id      String  @id @default(cuid())
  eventId String
  number  Int
  /// Free text, because a start time is a plan rather than a fact.
  startsAt String?

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lanes Lane[]

  @@unique([eventId, number])
}

/// One lane of one heat, and who is in it.
model Lane {
  id     String @id @default(cuid())
  heatId String
  number Int
  /// A team in team competitions, an athlete in individual ones.
  teamId    String?
  athleteId String?

  heat    Heat     @relation(fields: [heatId], references: [id], onDelete: Cascade)
  team    Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete Athlete? @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([heatId, number])
}

/// One line of a workout: "50 wall balls", with the loads that go with it.
///
/// Having these written down is what lets a capped result be entered as
/// "reps into wall balls" and turned into a total, rather than the scorekeeper
/// adding it up in their head.
model Movement {
  id         String  @id @default(cuid())
  eventId    String
  /// Fixed-team competitions run a different version per division. Null
  /// everywhere else, since only fixed teams have divisions.
  divisionId String?
  /// Running order within the workout.
  position   Int
  reps       Int
  name       String

  loadMode  LoadMode  @default(EACH)
  implement Implement @default(BARBELL)

  /// Loads are free text because they are not always a weight: a box jump is
  /// "60 cm". One per team type, since a pair of men and a mixed pair do not
  /// lift the same.
  loadMenMen     String?
  loadWomenWomen String?
  loadMixed      String?
  /// Unused in fixed-team competitions, where 60+ is not a category.
  loadSixtyPlus  String?

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  division Division? @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@index([eventId, position])
}

/// One result: either an athlete's or a team's, depending on competition mode.
/// Exactly one of athleteId / teamId is set.
model Score {
  id        String  @id @default(cuid())
  eventId   String
  athleteId String?
  teamId    String?

  /// The result as a single whole number, so results can be compared directly.
  /// Its meaning depends on the event's scoreType: seconds, reps or grams.
  value Int

  /// Optional secondary time used to separate identical results.
  tiebreakSeconds Int?

  /// What happened. Anyone who did not finish ranks below everyone who did,
  /// however good the partial result was, and a no-show ranks below that.
  status ScoreStatus @default(FINISHED)

  /// Free text for the scorekeeper, e.g. "judge disputed rep 41".
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  athlete Athlete? @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  team    Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  /// One result per athlete per event, and one per team per event.
  @@unique([eventId, athleteId])
  @@unique([eventId, teamId])
}
