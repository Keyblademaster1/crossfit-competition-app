# Copy this file to .env.local and paste your real Supabase connection string.
# .env.local is ignored by git, so the password never leaves your machine.
DATABASE_URL="postgresql://postgres:PASTE-YOUR-PASSWORD-HERE@db.PROJECT-ID.supabase.co:5432/postgres"

# --- Logging in with Google (see "Logging in" in the README) ---
# GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."
# BETTER_AUTH_SECRET="a long random string: openssl rand -base64 32"
# BETTER_AUTH_URL="http://localhost:3000"
# Google emails that may see the usage page, /admin, comma-separated.
# ADMIN_EMAILS="you@gmail.com"
# The address the privacy policy gives for questions about people's data.
# CONTACT_EMAIL="you@example.com"

# --- Branding (all optional) ---
# Leave these out and the app uses its built-in generic look: red and black,
# no logo. Set them on a local machine to apply a real brand.
# BRAND_NAME="Holger Functional Fitness"
# BRAND_PRIMARY="#3F512C"     # Holger green
# BRAND_SECONDARY="#684024"   # Holger brown
# BRAND_SCREEN_BACKGROUND="#231F20"
# Logo files live in public/brand/, which git ignores. Give the path as the
# browser sees it, so public/brand/logo-colour.png becomes /brand/logo-colour.png
# BRAND_LOGO_LIGHT="/brand/logo-colour.png"
# BRAND_LOGO_DARK="/brand/logo-white.png"
